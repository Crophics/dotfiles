#!/usr/bin/env bash
# Fetch the official Caelestia dots and refresh ~/.config/hypr from them.
# (`caelestia install`/`update` also install packages and overwrite more; this only
# touches the Hyprland config.) Personal changes live in ~/.config/caelestia/hypr-*.lua.
set -euo pipefail
src="${XDG_STATE_HOME:-$HOME/.local/state}/caelestia/dots"
if [ -d "$src/.git" ]; then
  git -C "$src" pull --ff-only
else
  mkdir -p "$(dirname "$src")"
  git clone --depth 1 https://github.com/caelestia-dots/caelestia.git "$src"
fi
mkdir -p "$HOME/.config/hypr"
# scheme/current.lua is generated per machine by the shell; never overwrite it
rsync -a --exclude 'scheme/current.lua' "$src/hypr/" "$HOME/.config/hypr/"
echo "dots at $(git -C "$src" log -1 --format='%h %s')"
if command -v hyprctl >/dev/null && hyprctl version >/dev/null 2>&1; then
  hyprctl reload >/dev/null
  sleep 1
  hyprctl configerrors
fi
