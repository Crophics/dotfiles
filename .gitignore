# Defense-in-depth: never track these even if accidentally copied in later
*.pem
*.key
id_rsa*
id_ed25519*
*_history
.env
*token*
*secret*
*password*
.DS_Store

# Python bytecode (e.g. from kitty kittens)
__pycache__/
*.pyc
# generated at runtime by 43pr theme.py
quickshell/.config/quickshell/Theme.qml
hypr/.config/hypr/hyprlock-colors.conf
# generated at runtime by 43pr theme.py
qt6ct/.config/qt6ct/colors/43pr.conf
btop/.config/btop/themes/43pr.theme
cava/.config/cava/themes/43pr
