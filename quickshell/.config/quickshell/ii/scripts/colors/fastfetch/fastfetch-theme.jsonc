{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/arch-ascii.txt",
    "position": "top",
    "padding": {
      "top": 1
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "key": "\u001b[90m╭────────────╮\u001b[0m",
      "type": "custom"
    },
    {
      "key": "\u001b[90m│\u001b[0m   user    \u001b[90m│\u001b[0m",
      "type": "title",
      "format": "\u001b[34m{user-name}\u001b[0m"
    },
    {
      "key": "\u001b[90m│\u001b[0m   hname   \u001b[90m│\u001b[0m",
      "type": "title",
      "format": "\u001b[34m{host-name}\u001b[0m"
    },
    {
      "key": "\u001b[90m│\u001b[0m 󰣇  distro  \u001b[90m│\u001b[0m",
      "type": "os",
      "format": "\u001b[34mArch Linux\u001b[0m"
    },
    {
      "key": "\u001b[90m│\u001b[0m   kernel  \u001b[90m│\u001b[0m",
      "type": "kernel",
      "format": "\u001b[34m{2}\u001b[0m"
    },
    {
      "key": "\u001b[90m│\u001b[0m   uptime  \u001b[90m│\u001b[0m",
      "type": "uptime",
      "format": "\u001b[34m{2}h, {3}m\u001b[0m"
    },
    {
      "key": "\u001b[90m│\u001b[0m $  shell   \u001b[90m│\u001b[0m",
      "type": "shell",
      "format": "\u001b[34m{1}\u001b[0m"
    },
    {
      "key": "\u001b[90m│\u001b[0m   pkgs    \u001b[90m│\u001b[0m",
      "type": "packages",
      "outputColor": "34"
    },
    {
      "key": "\u001b[90m│\u001b[0m   memory  \u001b[90m│\u001b[0m",
      "type": "memory",
      "format": "\u001b[34m{1} / {2}\u001b[0m"
    },
    {
      "key": "\u001b[90m├────────────┤\u001b[0m",
      "type": "custom"
    },
    {
      "key": "\u001b[90m│\u001b[0m   colors  \u001b[90m│\u001b[0m",
      "type": "colors",
      "symbol": "circle"
    },
    {
      "key": "\u001b[90m╰────────────╯\u001b[0m",
      "type": "custom"
    },
    { "type": "custom", "format": "" }
  ]
}
