{
  "material-code.primaryColor": "{{accent}}",
  "material-code.colors": {
    "background": "{{bg}}",
    "card": "{{bg_panel}}",
    "popover": "{{bg_card}}",
    "foreground": "#ffffff",
    "syntax.variable": "#ffffff"
  },
  "editor.tokenColorCustomizations": {
    "[Material Code]": {
      "textMateRules": [
        {
          "scope": ["variable.other.readwrite", "variable.parameter", "meta.function.parameters variable"],
          "settings": { "foreground": "#ffffff" }
        }
      ]
    }
  },
  "editor.semanticTokenColorCustomizations": {
    "[Material Code]": {
      "rules": { "variable": "#ffffff", "parameter": "#ffffff" }
    }
  }
}
