{
  "material-code.primaryColor": "{{accent}}",
  "material-code.colors": {
    "background": "{{bg}}",
    "card": "{{bg_panel}}",
    "popover": "{{bg_card}}",
    "foreground": "#ffffff",
    "syntax": {
      "comment": "{{fg_muted}}",
      "keyword": "{{danger}}",
      "function": "{{accent}}",
      "string": "{{term2}}",
      "constant": "{{term5}}",
      "property": "{{term6}}",
      "attribute": "{{term3}}",
      "variable": "#ffffff"
    }
  },
  "editor.tokenColorCustomizations": {
    "[Material Code]": {
      "textMateRules": [
        {
          "scope": [
            "source",
            "variable.other.readwrite",
            "variable.parameter",
            "meta.function.parameters variable"
          ],
          "settings": {
            "foreground": "#ffffff"
          }
        }
      ]
    }
  },
  "editor.semanticTokenColorCustomizations": {
    "[Material Code]": {
      "rules": {
        "variable": "#ffffff",
        "parameter": "#ffffff"
      }
    }
  }
}
